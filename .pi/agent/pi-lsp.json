{
  "timeout": 30000,
  "servers": {
    "biome": {
      "command": ["biome", "lsp-proxy"],
      "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".json",
        ".jsonc",
        ".css",
        ".graphql",
        ".gql",
        ".html",
        ".vue",
        ".astro",
        ".svelte"
      ]
    },
    "ty": { "command": ["ty", "server"], "extensions": [".py", ".pyi"] },
    "ruff": { "command": ["ruff", "server"], "extensions": [".py", ".pyi"] },
    "rust-analyzer": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"],
      "pullDiagnosticsGraceMs": 5000
    },
    "clangd": {
      "command": ["clangd", "--background-index", "--clang-tidy"],
      "extensions": [
        ".c",
        ".h",
        ".cpp",
        ".cc",
        ".cxx",
        ".c++",
        ".hpp",
        ".hh",
        ".hxx",
        ".h++"
      ]
    },
    "csharp": {
      "command": ["csharp-ls"],
      "extensions": [".cs"],
      "pushDiagnosticsGraceMs": 3000
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"],
      "initialization": {
        "redhat": { "telemetry": { "enabled": false } }
      }
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"],
      "pushDiagnosticsGraceMs": 2000
    },
    "markdown": {
      "command": ["rumdl", "server"],
      "extensions": [".md", ".markdown"]
    },
    "zls": {
      "command": ["zls"],
      "extensions": [".zig", ".zon"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"],
      "pushDiagnosticsGraceMs": 3000
    },
    "tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    },
    "fish": {
      "command": ["fish-lsp", "start"],
      "extensions": [".fish"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"],
      "initialization": {
        "json": {
          "validate": { "enable": true },
          "schemas": [
            { "fileMatch": ["package.json"], "url": "https://json.schemastore.org/package.json" },
            { "fileMatch": ["tsconfig.json", "tsconfig.*.json"], "url": "https://json.schemastore.org/tsconfig.json" },
            { "fileMatch": ["jsconfig.json", "jsconfig.*.json"], "url": "https://json.schemastore.org/jsconfig.json" },
            { "fileMatch": ["biome.json", "biome.jsonc"], "url": "https://biomejs.dev/schemas/2.6.7/schema.json" },
            { "fileMatch": [".eslintrc", ".eslintrc.json"], "url": "https://json.schemastore.org/eslintrc.json" },
            { "fileMatch": [".prettierrc", ".prettierrc.json"], "url": "https://json.schemastore.org/prettierrc.json" },
            { "fileMatch": [".babelrc", ".babelrc.json", "babel.config.json"], "url": "https://json.schemastore.org/babelrc.json" },
            { "fileMatch": ["global.json"], "url": "https://json.schemastore.org/global.json" },
            { "fileMatch": ["launchSettings.json"], "url": "https://json.schemastore.org/launchsettings.json" },
            { "fileMatch": ["appsettings.json", "appsettings.*.json"], "url": "https://json.schemastore.org/appsettings.json" }
          ]
        }
      }
    }
  }
}
