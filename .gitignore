**/QWEN.md
**/.qwen/
**/.opencode/
**/.pi/
**/chunks/

# Pi keeps its global config in ~/.pi/agent, alongside auth.json (API keys and
# OAuth tokens), session transcripts and caches. Re-include the directory, then
# allowlist config files only; add a line here to sync anything else.
!/.pi/
/.pi/*
!/.pi/agent/
/.pi/agent/*
!/.pi/agent/settings.json
!/.pi/agent/mcp.json
!/.pi/agent/models.json
!/.pi/agent/AGENTS.md
!/.pi/agent/keybindings.json
!/.pi/agent/extensions/
!/.pi/agent/skills/
!/.pi/agent/prompts/
!/.pi/agent/themes/

# Credentials and per-machine identity. Never in the repo, even by git add -A.
.ssh/
.gnupg/
.secrets/
.aws/
.copilot/
.steam/
.wine/
.pki/
.config/gh/hosts.yml
.config/grabit/
.config/pearl/
.config/wordcraft/
.config/github-copilot/
.config/opencode/service.json
*.pem
*.key
*.priv.pem

