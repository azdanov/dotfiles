// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": ""
      }
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "code_lens": "on",
  "toolbar": {
    "code_actions": true
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "always",
    "show_diagnostics": "errors",
    "git_status": false,
    "file_icons": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_picture": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "languages": {
    "Java": {
      "format_on_save": "off"
    },
    "CSharp": {
      "language_servers": ["csharp-ls", "!roslyn", "!omnisharp"]
    }
  },
  "lsp": {
    "jdtls": {
      "settings": {
        // Controls when to check for updates for JDTLS, Lombok, and Debugger
        // - "always" (default): Always check for and download the latest version
        // - "once": Check for updates only if no local installation exists
        // - "never": Never check for updates, only use existing local installations (errors if missing)
        //
        // Note: Invalid values will default to "always"
        // If custom paths (below) are provided, check_updates is IGNORED for that component
        "check_updates": "once"
      }
    }
  },
  "cli_default_open_behavior": "existing_window",
  "language_models": {
    "openai_compatible": {
      "Z.ai": {
        "api_url": "https://api.z.ai/api/coding/paas/v4",
        "available_models": [
          {
            "name": "glm-5.2",
            "display_name": "GLM-5.2",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
        ],
      },
      "Zoey": {
        "api_url": "",
        "available_models": [
          {
            "name": "ZoeyAGI",
            "max_tokens": 262144,
            "max_output_tokens": 64000,
            "max_completion_tokens": 100000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          }
        ]
      }
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "git_panel": {
    "tree_view": true,
    "file_icons": true,
    "dock": "left"
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_hidden": false,
    "hide_root": false,
    "indent_guides": {
      "show": "always"
    },
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "indent_size": 14.0,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "sticky_scroll": false,
    "dock": "left"
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "proxy": "",
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "never"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_fallbacks": ["MonoLisa"],
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "base_keymap": "JetBrains",
  "icon_theme": "Soft Charmed Icons",
  "agent": {
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^cd\\s+/home/azdanov/Projects/corebanking(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            }
          ]
        }
      }
    },
    "dock": "right",
    "sidebar_side": "right",
    "default_profile": "write",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "enable_thinking": false,
      "provider": "Zoey",
      "model": "ZoeyAGI"
    }
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 17,
  "buffer_font_family": "MonoLisa",
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark"
  }
}
