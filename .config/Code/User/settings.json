{
  "workbench.startupEditor": "none",
  "workbench.activityBar.compact": true,
  "resharper.region.region": "Europe",
  "resharper.dataSharing.allowDataSharing": false,
  "git.autofetch": true,
  "git.confirmSync": false,
  "explorer.confirmDelete": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.iconTheme": "charmed-soft",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.fontSize": 17,
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "editor.fontFamily": "MonoLisa, 'Droid Sans Mono', monospace",
  "telemetry.telemetryLevel": "off",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false,
  "keyboard.dispatch": "keyCode",
  "zig.zls.enabled": "on",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "chat.viewSessions.orientation": "stacked",
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
  },
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "mise.binPath": "/home/azdanov/.local/bin/mise",
  "workbench.colorTheme": "IntelliJ IDEA New UI Dark",
  "workbench.tree.enableStickyScroll": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "chat.stickyScroll.enabled": false,
  "chat.experimental.stickyScroll.enabled": false,
  "diffEditor.renderSideBySide": false,
  "update.showReleaseNotes": false,
  "varro.chat.defaultPermissionMode": "full",
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://spec.openapis.org/": true,
    "https://www.schemastore.org/": true,
  },
}
